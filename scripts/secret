#!/usr/bin/env bash
# Stores and checks local credentials in the macOS Keychain, so a secret's
# VALUE never lands in a shell command, a config file, a permission rule, or
# an agent transcript — only its NAME does.
#
#   scripts/secret set   pull-up-db-dev    # prompts; input is not echoed
#   scripts/secret check pull-up-db-dev    # reports present/absent only
#   scripts/secret rm    pull-up-db-dev
#
# `get` is deliberately absent. Nothing here ever prints a secret to stdout;
# the only consumer is scripts/dbq, which reads the Keychain itself and pipes
# the value straight into the process environment.
set -euo pipefail

usage() {
  echo "usage: scripts/secret {set|check|rm} <name>" >&2
  echo >&2
  echo "known names:" >&2
  echo "  pull-up-db-dev    DATABASE_URL for the Neon dev branch (default target)" >&2
  echo "  pull-up-db-prod   DATABASE_URL for Neon production (guarded; see scripts/dbq)" >&2
  exit 2
}

[ $# -eq 2 ] || usage
action=$1
name=$2

case "$action" in
  set)
    # -w with no argument makes `security` prompt on the tty. The value is
    # never an argv element, so it cannot leak through `ps` or shell history.
    if security find-generic-password -s "$name" >/dev/null 2>&1; then
      echo "replacing existing entry: $name" >&2
      security delete-generic-password -s "$name" >/dev/null 2>&1
    fi
    security add-generic-password -a "$USER" -s "$name" -w
    echo "stored: $name" >&2
    ;;
  check)
    if security find-generic-password -s "$name" >/dev/null 2>&1; then
      echo "present: $name" >&2
    else
      echo "MISSING: $name  (run: scripts/secret set $name)" >&2
      exit 1
    fi
    ;;
  rm)
    security delete-generic-password -s "$name" >/dev/null 2>&1 &&
      echo "removed: $name" >&2 ||
      { echo "not found: $name" >&2; exit 1; }
    ;;
  *) usage ;;
esac
