// Cloudflare Containers deployment for the Go API.
// The Worker in src/index.ts proxies every request into the container,
// which runs the image built from server/Dockerfile.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pull-up-api",
  "main": "src/index.ts",
  // Reviewed against Workers runtime/types on 2026-07-15.
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "EMAIL_FROM": "verify@pull-up.davisbrown.dev",
    "WEB_ORIGIN": "https://pull-up.davisbrown.dev",
    // Account id for the Workers AI REST call that backs text moderation.
    // Not a secret — it appears in dashboard URLs — and useless without
    // CLOUDFLARE_AI_TOKEN, which is.
    "CLOUDFLARE_ACCOUNT_ID": "720bb9fc6dc82b02f5612a450a8d6ebf"
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "JWT_SECRET",
      "UPLOAD_SIGNING_SECRET",
      "INTERNAL_TASK_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../server/Dockerfile",
      "image_build_context": "../../server",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ApiContainer"
      ]
    }
  ],
  // Court photos, uploaded via HMAC-signed URLs issued by the Go API.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "pull-up-photos"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
