// Cloudflare Containers deployment for the Go API.
// The Worker in src/index.ts proxies every request into the container,
// which runs the image built from server/Dockerfile.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pull-up-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../server/Dockerfile",
      "image_build_context": "../../server",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ApiContainer"
      ]
    }
  ],
  // Court photos, uploaded via HMAC-signed URLs issued by the Go API.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "pull-up-photos"
    }
  ],
  "observability": {
    "enabled": true
  }
}
