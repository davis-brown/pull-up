# Copy to .env (gitignored). EXPO_PUBLIC_* values are embedded in the client.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Maps need no token: MapLibre + OpenFreeMap.

# Google sign-in (optional — buttons hidden until set). Create OAuth clients
# at console.cloud.google.com; the same IDs go in the server's
# GOOGLE_CLIENT_IDS. Apple sign-in needs no client-side config, but the
# server needs APPLE_AUDIENCES=com.pullup.app.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional: Sentry crash reporting (leave unset to disable)
EXPO_PUBLIC_SENTRY_DSN=

# Optional: public web origin used to build shareable court/run links and
# for universal/app-link association. Defaults to https://pullup.app.
EXPO_PUBLIC_WEB_URL=
