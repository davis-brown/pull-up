# Copy to .env (gitignored). EXPO_PUBLIC_* values are embedded in the client.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-mapbox-token

# Native builds only: secret token for downloading the Mapbox SDK.
# Set in EAS secrets for cloud builds. Never commit the real value.
MAPBOX_DOWNLOAD_TOKEN=sk.your-secret-download-token
