// Cloudflare Worker fronting the Expo web build's static assets.
// Build first (dist/ is the export output), then deploy with the repository's
// pinned Wrangler from deploy/api. Browser API traffic stays on this origin and
// reaches pull-up-api over the service binding below.
{
  "$schema": "../deploy/api/node_modules/wrangler/config-schema.json",
  "name": "pull-up-web",
  "main": "worker.ts",
  // Reviewed against Workers runtime/types on 2026-07-15.
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "pull-up-api"
    }
  ],
  // IOS_APP_ID and APPLE_APP_STORE_ID are optional dashboard vars. Invalid or
  // missing values disable their metadata safely. ANDROID_CERT_SHA256 is the
  // EAS-managed release keystore fingerprint (not a secret — it ships in every
  // APK); it activates /.well-known/assetlinks.json for Android App Links.
  "vars": {
    "ANDROID_CERT_SHA256": "B7:2F:60:6E:6B:15:F9:E4:06:BD:A5:B3:BF:1A:FE:D7:C4:96:C1:9C:12:1F:0C:6A:27:2B:66:CF:B7:4C:97:26"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
