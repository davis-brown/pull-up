// Cloudflare Worker fronting the Expo web build's static assets.
// Build first (dist/ is the export output), then deploy with the repository's
// pinned Wrangler from deploy/api. Browser API traffic stays on this origin and
// reaches pull-up-api over the service binding below.
{
  "$schema": "../deploy/api/node_modules/wrangler/config-schema.json",
  "name": "pull-up-web",
  "main": "worker.ts",
  // Reviewed against Workers runtime/types on 2026-07-15.
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "pull-up-api"
    }
  ],
  // IOS_APP_ID, ANDROID_CERT_SHA256, and APPLE_APP_STORE_ID are optional
  // dashboard vars. Invalid or missing values disable their metadata safely.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
